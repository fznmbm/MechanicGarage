# Copy this file to .env.local and fill in your Supabase project values
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# DVSA MOT History API (free) – register at https://documentation.history.mot.api.gov.uk/mot-history-api/register
# Server-only values: never prefix with NEXT_PUBLIC_
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_API_KEY=
DVSA_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
DVSA_SCOPE=https://tapi.dvsa.gov.uk/.default

# DVLA Vehicle Enquiry Service (optional, adds tax status). Registration currently closed.
DVLA_API_KEY=

# Email (optional) – Resend free tier, https://resend.com. Verify your domain there first.
# Without these, "Email" opens the user's own mail app instead.
RESEND_API_KEY=
EMAIL_FROM=invoices@yourdomain.co.uk

# Service key (Supabase → Project Settings → API → service_role). Server-only, keep secret.
# Needed for: automatic reminder emails, Stripe webhooks, photos on the customer approval page.
SUPABASE_SERVICE_ROLE_KEY=

# Protects the daily reminders job. Any long random string; Vercel Cron sends it automatically.
CRON_SECRET=

# Stripe subscription billing for garages (optional until you start charging)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_PRODUCT_NAME=RampDesk
